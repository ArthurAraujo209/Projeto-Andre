<div class="linha-material">
    <div class="info-principal">
        <h3>{{this.titulo}}</h3>
        <p><strong>Disciplina:</strong> {{this.disciplina}}</p>
    </div>
    <div class="info-secundaria">
        <span class="badge-tipo">{{this.tipo}}</span>
        <span class="data-material">{{formatarData this.data}}</span>
        <a href="/materiais/{{this.id}}" class="btn-abrir">Abrir</a>
    </div>
</div>